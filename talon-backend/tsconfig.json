{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2023",

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@config/*": ["src/config/*"],
      "@common/*": ["src/common/*"],
      "@database/*": ["src/database/*"],
      "@modules/*": ["src/*"],
      "@logger/*": ["src/logger/*"],
      "@users/*": ["src/users/*"],
      "@auth/*": ["src/auth/*"],
      "@mail/*": ["src/mail/*"],
      "@settings/*": ["src/settings/*"]
    },

    "outDir": "./dist",
    "sourceMap": true,
    "declaration": true,
    "removeComments": true,
    "incremental": true,

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "strict": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  }
}