{
  "name": "talon-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "api:types": "openapi-typescript ${API_URL:-http://localhost:3000}/api/docs-json -o lib/api/schema.d.ts",
    "analyze": "ANALYZE=true next build",
    "prepare": "husky"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@tanstack/react-query": "^5",
    "@radix-ui/react-slot": "^1",
    "@radix-ui/react-label": "^2",
    "@radix-ui/react-dialog": "^1",
    "@radix-ui/react-alert-dialog": "^1",
    "@radix-ui/react-dropdown-menu": "^2",
    "@radix-ui/react-separator": "^1",
    "@radix-ui/react-tooltip": "^1",
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "tailwind-merge": "^2",
    "lucide-react": "^1",
    "sonner": "^1",
    "date-fns": "^3",
    "recharts": "^2",
    "tw-animate-css": "^1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "openapi-typescript": "^7",
    "prettier": "^3",
    "prettier-plugin-tailwindcss": "^0.6",
    "husky": "^9",
    "lint-staged": "^15",
    "@next/bundle-analyzer": "^16"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  }
}
